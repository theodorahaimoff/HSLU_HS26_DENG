# Example configuration. Copy this file to ".env" and adjust the values:
#   cp .env.example .env
# The real .env is ignored by Git and must never be committed.
# Replace every example password BEFORE the first "docker compose up":
# database passwords are set on first start, and editing .env later does not change them.

# --- PostgreSQL: our pipeline data -------------------------------------------
POSTGRES_USER=deng
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rail_weather

# Where the ingestion scripts find the database.
# - Scripts run on your own machine (venv, notebooks):  POSTGRES_HOST=localhost
# - Scripts run by Kestra inside Docker:                 the flow sets POSTGRES_HOST=postgres itself
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- pgAdmin ------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=student@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin
PGADMIN_PORT=8086

# --- Kestra -------------------------------------------------------------------
# Same format as the course lab: an email-style login and a strong password.
KESTRA_USER=student@example.com
KESTRA_PASSWORD=Change-me-Kestra1!
KESTRA_DB_PASSWORD=change_me_kestra_db
KESTRA_PORT=8080
